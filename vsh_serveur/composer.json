{
    "name": "vision-homecare/vsh-serveur",
    "description": "API REST et interface web de Vision Homecare",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=7.3",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Vsh\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vsh\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "7.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
