# Copier ce fichier en .env et renseigner les valeurs. Ne jamais versionner .env.
# Les variables d'environnement du serveur sont prioritaires sur ce fichier.

# production | local | testing
APP_ENV=production
# Jamais true en production (ignoré si APP_ENV=production)
APP_DEBUG=false
APP_URL=https://api.exemple.ne
# 64 caractères hexadécimaux : php bin/console.php key:generate
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vsh_homecare
DB_USERNAME=
DB_PASSWORD=

# debug | info | warning | error | critical
LOG_LEVEL=info

# Origines web autorisées (séparées par des virgules), ex. https://admin.exemple.ne
CORS_ALLOWED_ORIGINS=
# Adresses IP des reverse proxies de confiance (séparées par des virgules)
TRUSTED_PROXIES=
DEFAULT_COUNTRY_CODE=227

ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL_DAYS=30

# SMS (D-002) : log | twilio | http
SMS_DRIVER=log
SMS_SENDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
# Valeur complète de l'en-tête Authorization, ex. "Bearer xxxxx"
SMS_HTTP_AUTH_HEADER=
# Modèle JSON du corps de requête ; {to}, {sender} et {message} sont remplacés
SMS_HTTP_BODY_TEMPLATE='{"to":"{to}","from":"{sender}","message":"{message}"}'

# Notifications push (D-011) : none | log | fcm. Activer ensuite le paramètre notifications.push_enabled.
PUSH_DRIVER=none
# Fichier JSON du compte de service Firebase (console Firebase > Paramètres > Comptes de service),
# placé hors du dossier public, jamais versionné.
FCM_CREDENTIALS_FILE=
# Facultatif : par défaut, project_id du compte de service
FCM_PROJECT_ID=
# Tentatives avant abandon d'un push ou d'un SMS, et âge maximal (heures) d'une notification envoyée
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_EXPIRE_HOURS=12
